static func all_spells() -> Dictionary:
	var spells: Dictionary = {}

	for element_id in ELEMENTS:
		spells[element_id + "_spheres"] = {
			"element": element_id,
			"name": "Стихийные сферы",
			"description": "Маг выпускает сферы прямо в сторону врагов.",
			"upgrade": "Количество сфер: 1 → 2 → 3."
		}

		spells[element_id + "_orbit"] = {
			"element": element_id,
			"name": "Стихийная орбита",
			"description": "Сферы вращаются вокруг мага и наносят урон при соприкосновении с врагами.",
			"upgrade": "Количество сфер: 1 → 2 → 3. Скорость вращения и урон не меняются."
		}

	for spell_id in UNIQUE_SPELLS:
		var entry: Array = UNIQUE_SPELLS[spell_id]
		spells[spell_id] = {
			"element": entry[0],
			"name": entry[1],
			"description": entry[2],
			"upgrade": entry[3]
		}

	return spells


static func get_spell(spell_id: String) -> Dictionary:
	return all_spells().get(spell_id, {})
